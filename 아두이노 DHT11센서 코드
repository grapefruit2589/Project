//아두이노 IDE라이브러리인 "DHT sensor library"다운로드
//아두이노 보드 연결
#include "DHT.h"
//DHT sensor library 속 헤더파일인 DHT.h 인클루드

#define DHTPIN A0      // DHT11 센서의 데이터 핀 연결 핀 번호
#define DHTTYPE DHT11  // DHT11 사용

DHT dht(DHTPIN, DHTTYPE);

void setup() {
  Serial.begin(9600); 
  dht.begin();
}

void loop() {//온습도 데이터 반복 출력
  // 온도 및 습도 데이터를 읽음
  float h = dht.readHumidity();
  float t = dht.readTemperature();

  // 데이터를 정상적으로 읽었는지 확인
  if (isnan(h) || isnan(t)) {
    Serial.println("Failed to read from DHT sensor!");
    return;
  }

  // 시리얼 모니터에 가로 텍스트로 출력
  Serial.print("온도: ");
  Serial.print(t);
  Serial.print(" °C ");
  Serial.print("습도: ");
  Serial.print(h);
  Serial.println(" %");

  delay(500); // 2초마다 업데이트
}
